<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view -->
    <record id="view_excalidraw_drawing_list" model="ir.ui.view">
        <field name="name">excalidraw.drawing.list</field>
        <field name="model">excalidraw.drawing</field>
        <field name="arch" type="xml">
            <list string="Drawings">
                <field name="name"/>
                <field name="preview_image" widget="image" options="{'size': [64, 64]}" optional="show"/>
                <field name="element_count" optional="hide"/>
                <field name="write_date"/>
                <field name="create_uid" optional="hide"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_excalidraw_drawing_form" model="ir.ui.view">
        <field name="name">excalidraw.drawing.form</field>
        <field name="model">excalidraw.drawing</field>
        <field name="arch" type="xml">
            <form string="Drawing">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Sales flow sketch"/>
                        </h1>
                    </div>
                    <!-- Fields loaded for the widget but hidden from the layout -->
                    <field name="active" invisible="1"/>
                    <field name="preview_image" widget="image" invisible="1"/>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="scene_data" widget="excalidraw_canvas" nolabel="1" colspan="2" readonly="0"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_excalidraw_drawing_search" model="ir.ui.view">
        <field name="name">excalidraw.drawing.search</field>
        <field name="model">excalidraw.drawing</field>
        <field name="arch" type="xml">
            <search string="Drawings">
                <field name="name"/>
                <field name="create_uid"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <separator/>
                <group>
                    <filter string="Created by" name="group_create_uid" context="{'group_by': 'create_uid'}"/>
                    <filter string="Last Modified" name="group_write_date" context="{'group_by': 'write_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_excalidraw_drawing" model="ir.actions.act_window">
        <field name="name">Excalidraw</field>
        <field name="res_model">excalidraw.drawing</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first drawing</p>
            <p>Sketch diagrams, flows and ideas with the embedded Excalidraw whiteboard.</p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem
        id="menu_excalidraw_root"
        name="Excalidraw"
        sequence="90"
        web_icon="excalidraw_for_odoo,static/description/icon.png"
        groups="group_excalidraw_user"
    />
    <menuitem
        id="menu_excalidraw_drawing"
        name="Drawings"
        parent="menu_excalidraw_root"
        action="action_excalidraw_drawing"
        sequence="10"
        groups="group_excalidraw_user"
    />
</odoo>
