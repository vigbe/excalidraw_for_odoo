<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="excalidraw_for_odoo.ExcalidrawCanvasField" owl="1">
        <div class="o_excalidraw_for_odoo_field">
            <t t-if="props.readonly">
                <div class="o_excalidraw_preview d-flex justify-content-center align-items-center">
                    <img
                        t-if="previewSrc"
                        t-att-src="previewSrc"
                        alt="Drawing preview"
                        class="img-fluid rounded shadow-sm"
                    />
                    <div t-else="" class="text-muted p-4 fst-italic">
                        No preview yet. Switch to edit mode to draw.
                    </div>
                </div>
            </t>
                <t t-else="">
                    <div t-if="state.error" class="alert alert-danger mb-2" role="alert" t-esc="state.error"/>
                    <div class="o_excalidraw_toolbar d-flex justify-content-end mb-1">
                        <button
                            type="button"
                            class="o_excalidraw_theme_toggle btn btn-sm"
                            t-on-click="toggleTheme"
                            t-att-title="themeTooltip"
                            t-att-aria-label="themeTooltip"
                        >
                            <svg t-if="effectiveTheme === 'dark'" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="5"/>
                                <line x1="12" y1="1" x2="12" y2="3"/>
                                <line x1="12" y1="21" x2="12" y2="23"/>
                                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                                <line x1="1" y1="12" x2="3" y2="12"/>
                                <line x1="21" y1="12" x2="23" y2="12"/>
                                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                            </svg>
                            <svg t-else="" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                            </svg>
                        </button>
                    </div>
                    <div class="o_excalidraw_canvas_wrap position-relative">
                    <div class="o_excalidraw_canvas" t-ref="excalidraw_container"/>
                    <div
                        t-if="state.loading"
                        class="o_excalidraw_spinner position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
                    >
                        <span class="spinner-border me-2" role="status"/>
                        <span>Loading the Excalidraw editor…</span>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
