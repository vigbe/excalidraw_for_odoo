<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module category (Odoo 19) -->
    <record id="module_category_excalidraw_for_odoo" model="ir.module.category">
        <field name="name">Excalidraw</field>
        <field name="sequence">60</field>
    </record>

    <!-- Privilege for security groups (Odoo 19 pattern) -->
    <record id="excalidraw_for_odoo_privilege" model="res.groups.privilege">
        <field name="name">Excalidraw</field>
        <field name="category_id" ref="module_category_excalidraw_for_odoo"/>
    </record>

    <!-- Security groups using privilege_id (NOT category_id) per Odoo 19 -->
    <record id="group_excalidraw_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="excalidraw_for_odoo_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can create and edit Excalidraw drawings.</field>
    </record>

    <record id="group_excalidraw_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="excalidraw_for_odoo_privilege"/>
        <field name="implied_ids" eval="[(4, ref('group_excalidraw_user'))]"/>
        <field name="comment">Can also delete Excalidraw drawings.</field>
    </record>
</odoo>
